# RunPod env vars for `runpod/start.sh`.
# Copy to runpod.env (or set these as RunPod "Pod Environment Variables").
# All values below are OPTIONAL — start.sh has sensible defaults.

# Experiment name (subdir under checkpoints/pi05_so101_lora/).
EXP_NAME="robot_arm_v1"

# Hugging Face token. Only needed if you make the dataset private later,
# or want to push the trained adapter back to HF.
HF_TOKEN=""

# Weights & Biases. If empty, training runs in offline mode and you can
# `wandb sync` the local run dir later.
WANDB_API_KEY=""

# Set to 0 to skip the norm-stats computation step (e.g., on a resumed run
# where assets/pi05_so101_lora/.../norm_stats.json already exists).
RUN_NORM_STATS=1
